# --- Server ---
PORT=8787
# Public HTTPS URL of this server. The SPP OAuth redirect URI must be exactly
# ${PUBLIC_URL}/auth/callback
PUBLIC_URL=https://spp-assistant.topstepllc.com
# Your extension's origin (chrome://extensions shows the ID). Comma-separate several.
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=8000

# --- SuiteProjects Pro ---
# Company ID from your SPP URL: https://<company-id>.app.netsuitesuiteprojectspro.com
SPP_COMPANY_ID=
SPP_SANDBOX=false
# From Administration > Global Settings > Account > Integration: OAuth 2.0 application
SPP_CLIENT_ID=
SPP_CLIENT_SECRET=
SPP_SCOPE=rest+xml
# XML API namespace and key (from SPP Support / Integration settings)
SPP_API_NAMESPACE=
SPP_API_KEY=

# Where per-user SPP tokens are stored (keep this file private)
# TOKEN_STORE_FILE=./data/sessions.json
